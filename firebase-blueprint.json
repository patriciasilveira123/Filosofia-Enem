{
  "entities": {
    "PrivateUserProfile": {
      "title": "PrivateUserProfile",
      "description": "Dados privados de identificação do estudante autenticado (isolados por proprietário).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário autenticado."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "E-mail do estudante."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Nome de exibição do estudante."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação do perfil."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização."
        }
      },
      "required": ["ownerId", "email", "displayName", "createdAt", "updatedAt"]
    },
    "SimuladoProgress": {
      "title": "SimuladoProgress",
      "description": "Progresso salvo do estudante no simulado FiloENEM (respostas e última questão acessada).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do proprietário do progresso."
        },
        "answers": {
          "type": "object",
          "description": "Mapa de respostas no formato { questionId: 'A' | 'B' | 'C' | 'D' | 'E' }."
        },
        "currentQuestionId": {
          "type": "integer",
          "description": "ID (1 a 500) da questão em que o estudante parou."
        },
        "selectedUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Filtro de unidade selecionado."
        },
        "selectedDifficulty": {
          "type": "string",
          "enum": ["all", "Fácil", "Médio", "Difícil"],
          "minLength": 1,
          "maxLength": 16,
          "description": "Filtro de nível TRI selecionado."
        },
        "statusFilter": {
          "type": "string",
          "enum": ["todas", "nao_respondidas", "erradas"],
          "minLength": 1,
          "maxLength": 32,
          "description": "Filtro de status selecionado."
        },
        "pageTheme": {
          "type": "string",
          "enum": ["claro", "sepia", "escuro"],
          "minLength": 1,
          "maxLength": 16,
          "description": "Tema visual preferido."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp de criação do documento."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp da última sincronização."
        }
      },
      "required": [
        "ownerId",
        "answers",
        "currentQuestionId",
        "selectedUnit",
        "selectedDifficulty",
        "statusFilter",
        "pageTheme",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PrivateUserProfile" },
      "description": "Perfil privado isolado do usuário autenticado (docId: 'profile')."
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": { "$ref": "#/entities/SimuladoProgress" },
      "description": "Progresso de respostas e ponto de retomada do estudante (progressId: 'simulado')."
    }
  }
}
